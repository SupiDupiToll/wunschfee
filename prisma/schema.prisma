generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model GiftList {
  id               String    @id
  userId           String
  slug             String    @unique
  title            String
  honoreeName      String    @map("honoree_name")
  birthdayLabel    String?   @map("birthday_label")
  eventDate        DateTime? @map("event_date")
  message          String?
  hideReservations  Boolean   @default(false) @map("hide_reservations")
  isArchived        Boolean   @default(false) @map("is_archived")
  invitationHeadline String?  @map("invitation_headline")
  invitationMessage  String?  @map("invitation_message")
  bgStyle           String?   @default("default") @map("bg_style")
  decorations       String?   @default("none") @map("decorations")
  qrDarkColor       String?   @default("#1a1a1a") @map("qr_dark_color")
  qrLightColor      String?   @default("#ffffff") @map("qr_light_color")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  items GiftItem[]

  @@map("gift_lists")
}

model GiftItem {
  id         String    @id
  listId     String    @map("list_id")
  title      String
  url        String
  imageUrl   String?   @map("image_url")
  images     String?   @map("images")
  price      String?
  asin       String?
  store      String?
  sortOrder  Int       @default(0) @map("sort_order")
  isReserved Boolean   @default(false) @map("is_reserved")
  reservedBy String?   @map("reserved_by")
  reservedAt DateTime? @map("reserved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  list GiftList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@map("gift_items")
}
