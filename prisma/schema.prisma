generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model GiftList {
  id               String    @id
  userId           String
  slug             String    @unique
  title            String
  honoreeName      String    @map("honoree_name")
  birthdayLabel    String?   @map("birthday_label")
  eventDate        DateTime? @map("event_date")
  message          String?
  accessType       String    @default("public") @map("access_type")
  accessPassword   String?   @map("access_password")
  hideReservations Boolean   @default(false) @map("hide_reservations")
  isArchived       Boolean   @default(false) @map("is_archived")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  items GiftItem[]

  @@map("gift_lists")
}

model GiftItem {
  id         String    @id
  listId     String    @map("list_id")
  title      String
  url        String
  imageUrl   String?   @map("image_url")
  price      String?
  asin       String?
  store      String?
  sortOrder  Int       @default(0) @map("sort_order")
  isReserved Boolean   @default(false) @map("is_reserved")
  reservedBy String?   @map("reserved_by")
  reservedAt DateTime? @map("reserved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  list GiftList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@map("gift_items")
}
